# 仅放变量名和安全示例，不得提交真实密码或 Token
APP_ENV=development
APP_PORT=8080
API_BASE_URL=http://localhost:8080
DATABASE_URL=postgresql://user:password@localhost:5432/maintenance_dev
LOG_LEVEL=INFO

# 跨模块接口地址（按实际技术方案修改）
EQUIPMENT_SERVICE_URL=http://localhost:8101
WARNING_SERVICE_URL=http://localhost:8102
MAINTENANCE_SERVICE_URL=http://localhost:8103
INTEGRATION_SERVICE_URL=http://localhost:8104

# 开发环境示例值，不可用于生产
JWT_SECRET=replace-me-in-local-env
INTERNAL_API_TOKEN=replace-me-with-the-same-local-value-in-four-services
