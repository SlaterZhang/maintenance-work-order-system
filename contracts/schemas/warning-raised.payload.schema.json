{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.edu/contracts/warning-raised.payload.schema.json",
  "title": "WarningRaised payload",
  "type": "object",
  "required": [
    "warningId",
    "equipmentId",
    "riskLevel",
    "healthScore",
    "suspectedFault",
    "recommendedAction",
    "warningAt",
    "modelVersion",
    "metricSnapshot"
  ],
  "properties": {
    "warningId": {
      "type": "string",
      "pattern": "^WARN-[0-9]{8}-[0-9]{4}$"
    },
    "equipmentId": {
      "type": "string",
      "pattern": "^EQ-[0-9]{6}$"
    },
    "riskLevel": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "healthScore": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "suspectedFault": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "recommendedAction": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "warningAt": {
      "type": "string",
      "format": "date-time"
    },
    "modelVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "metricSnapshot": {
      "type": "object",
      "required": [
        "sampleId",
        "measuredAt",
        "temperatureC",
        "vibrationMmS",
        "currentA",
        "rotationalSpeedRpm"
      ],
      "properties": {
        "sampleId": {
          "type": "string",
          "format": "uuid"
        },
        "measuredAt": {
          "type": "string",
          "format": "date-time"
        },
        "temperatureC": {
          "type": "number",
          "minimum": -50,
          "maximum": 250
        },
        "vibrationMmS": {
          "type": "number",
          "minimum": 0,
          "maximum": 200
        },
        "currentA": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000
        },
        "rotationalSpeedRpm": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
