# 成员 B（故障预警与健康评估）本地配置示例
# 只提交变量名与安全示例值，不得提交真实 Token 或个人路径。

# 本服务端口（契约 docs/06 第 2 节：B 固定 8102）
MEMBER_B_PORT=8102
DATABASE_URL=sqlite:///./member_b.db

# 与 A/C/D 共用的服务间令牌，四个服务必须配置成同一个值
INTERNAL_API_TOKEN=dev-internal-token-change-me

# 跨模块直连地址（变量名与仓库根目录 .env.example 保持一致）
EQUIPMENT_SERVICE_URL=http://localhost:8101
MAINTENANCE_SERVICE_URL=http://localhost:8103
INTEGRATION_SERVICE_URL=http://localhost:8104

# 评分模型版本，会写入每条预警的 modelVersion 字段
MODEL_VERSION=rule-engine-1.0.0

# 外部服务不可达时是否降级为本地 mock。
# 仅限本地独立开发：置为 false 时 A/D 不可达会直接失败（fail closed），
# 不会伪造设备档案或权限。演示与联调必须使用 false 或真实服务。
ALLOW_CLIENT_MOCK=true

# 外部 HTTP 调用超时（秒）
CLIENT_TIMEOUT_SECONDS=3.0
